#!/bin/bash
#-------------------------------------------------------------------------------------------
# Instalacion del plugin /opt/cnm-sp/dns-check
#-------------------------------------------------------------------------------------------

[ -f /opt/cnm-sp/dns-check/pre-install ] && { /opt/cnm-sp/dns-check/pre-install || exit $?; }

/update/db/db-manage.php -p /opt/cnm-sp/dns-check || exit $?

[ -f /opt/cnm-sp/dns-check/post-install ] && exec /opt/cnm-sp/dns-check/post-install
exit 0
